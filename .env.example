# Surtec Control Plane — local dashboard and dispatch runner
# Codex authentication is managed by the installed CLI. Do not copy credentials here.
# Optional runtime overrides:
SURTEC_CODEX_BIN=codex
SURTEC_CODEX_MODEL=
SURTEC_CODEX_REASONING_EFFORT=

# Optional durable-worker limits (shown with defaults):
SURTEC_WORKER_CONCURRENCY=2
SURTEC_WORKER_POLL_MS=250
SURTEC_WORKER_LEASE_MS=30000
SURTEC_WORKER_HEARTBEAT_MS=5000
SURTEC_WORKER_RETRY_BASE_MS=1000
SURTEC_TASK_MAX_ATTEMPTS=3
SURTEC_TASK_MAX_RUNTIME_MS=300000
SURTEC_TASK_MAX_TOTAL_TOKENS=200000

# Railway deploy status (C.2): an account/workspace token (https://railway.com/account/tokens).
# Read-only; only used to query the latest deployment state. Leave unset to hide the Railway line.
RAILWAY_TOKEN=
