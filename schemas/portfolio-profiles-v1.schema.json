{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.local/schemas/portfolio-profiles-v1.schema.json",
  "title": "Previous local portfolio profiles document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": { "const": 1 },
    "projects": {
      "type": "object",
      "propertyNames": { "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
      "additionalProperties": { "$ref": "project-profile-v1.schema.json" }
    }
  }
}
