              "type": "null"
            }
          ]
        },
        "stage_kind": {
          "anyOf": [
            {
              "enum": [
                "analysis",
                "planning",
                "implementation",
                "review",
                "qa",
                "operations",
                "correction"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
