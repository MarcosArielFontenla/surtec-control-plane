        "decision_reason": {
          "anyOf": [
            {
              "enum": [
                "scope-changed",
                "policy-changed",
                "conflicting-evidence",
                "budget-exhausted",
                "correction-exhausted",
                "required-harness",
                "external-action",
                "dependency-blocked",
                "evidence-gap"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_status": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "candidate_validity": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
