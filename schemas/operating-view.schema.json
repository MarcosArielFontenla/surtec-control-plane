{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/operating-view.schema.json",
  "title": "OperatingView v1 - derived navigation facts, never execution authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "view",
    "focus_id",
    "focus_status",
    "generated_at",
    "execution_authority",
    "phase_p",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "view": {
      "enum": [
        "overview",
        "objective",
        "project",
        "issue"
      ]
    },
    "focus_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "focus_status": {
      "enum": [
        "available",
        "not-found",
        "unavailable"
      ]
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "execution_authority": {
      "const": "none"
    },
    "phase_p": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_cutover",
        "continuity"
      ],
      "properties": {
        "budget_cutover": {
          "const": "not-enabled"
        },
        "continuity": {
          "const": "deferred"
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32
    },
    "workflowTemplate": {
      "enum": [
        "analysis",
        "implementation",
        "quality-review",
        "operations-investigation",
        "trivial-change"
      ]
    },
    "projectKind": {
      "enum": [
        "personal",
        "internal-tool",
        "surtec-product",
        "client-product",
        "experiment",
        "template"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "state": {
          "enum": [
            null,
            "draft",
            "active",
            "paused",
            "achieved",
            "cancelled",
            "idea",
            "discovery",
            "maintenance",
            "archived",
            "proposed",
            "authorized",
            "working",
            "checking",
            "needs-decision",
            "ready-for-review",
            "done",
            "blocked",
            "queued",
            "running",
            "finished",
            "waiting-human",
            "completed",
            "open",
            "acknowledged",
            "snoozed",
            "resolved",
            "planned",
            "in-progress",
            "absent",
            "healthy",
            "partial",
            "legacy",
            "invalid",
            "unknown",
            "unconfigured",
            "within-limits",
            "warning",
            "denied"
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            {
              "type": "null"
            }
          ]
        },
        "criteria": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "principles": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_objective_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "primary_objective_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "issue_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "role_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow_template_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/workflowTemplate"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/projectKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
