        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "company": {},
            "objectives": {},
            "projects": {},
            "issues": {},
            "executions": {},
            "workflows": {},
            "signals": {},
            "commitments": {},
            "harness": {},
            "sessions": {},
            "budgets": {}
