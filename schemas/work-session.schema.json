{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.local/schemas/work-session.schema.json",
  "title": "Work Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "project_id", "objective", "status", "branch", "started_at",
    "paused_at", "completed_at", "related_task_ids", "related_run_ids", "notes", "result_summary",
    "next_action", "focused_ms", "active_since"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": { "enum": ["active", "paused", "completed"] },
    "branch": { "type": ["string", "null"], "maxLength": 255 },
    "started_at": { "type": "string", "format": "date-time" },
    "paused_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "related_task_ids": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" }
    },
    "related_run_ids": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" }
    },
    "notes": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "result_summary": { "type": ["string", "null"], "maxLength": 2000 },
    "next_action": { "type": ["string", "null"], "maxLength": 1000 },
    "focused_ms": { "type": "integer", "minimum": 0, "maximum": 31536000000 },
    "active_since": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
      "then": {
        "properties": { "active_since": { "type": "string", "format": "date-time" }, "paused_at": { "type": "null" }, "completed_at": { "type": "null" } }
      }
    },
    {
      "if": { "properties": { "status": { "const": "paused" } }, "required": ["status"] },
      "then": {
        "properties": { "active_since": { "type": "null" }, "paused_at": { "type": "string", "format": "date-time" }, "completed_at": { "type": "null" } }
      }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "properties": { "active_since": { "type": "null" }, "paused_at": { "type": "null" }, "completed_at": { "type": "string", "format": "date-time" }, "next_action": { "type": "string", "minLength": 1 }, "result_summary": { "type": "string", "minLength": 1 } }
      }
    }
  ]
}
