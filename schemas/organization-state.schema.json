{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.local/schemas/organization-state.schema.json",
  "title": "Local SURTEC organization state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "company", "objectives", "project_objectives"],
  "properties": {
    "schema_version": { "const": 1 },
    "company": { "$ref": "company-profile.schema.json" },
    "objectives": {
      "maxProperties": 500,
      "type": "object",
      "propertyNames": { "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "id", "company_id", "title", "desired_outcome", "success_criteria", "status", "horizon", "priority", "target_date", "parent_objective_id", "owner", "last_reviewed_at"],
        "properties": {
          "schema_version": { "const": 1 }, "id": { "type": "string" }, "company_id": { "const": "surtec" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 }, "desired_outcome": { "type": "string", "minLength": 1, "maxLength": 800 },
          "success_criteria": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
          "status": { "enum": ["draft", "active", "paused", "achieved", "cancelled"] }, "horizon": { "enum": ["now", "quarter", "year", "ongoing"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 }, "target_date": { "type": ["string", "null"], "format": "date" },
          "parent_objective_id": { "type": ["string", "null"] }, "owner": { "const": "marcos" }, "last_reviewed_at": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "project_objectives": {
      "type": "object",
      "propertyNames": { "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["objective_ids", "primary_objective_id"],
        "properties": {
          "objective_ids": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "type": "string" } },
          "primary_objective_id": { "type": ["string", "null"] }
        }
      }
    }
  }
}
