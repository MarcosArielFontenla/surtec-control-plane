{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/evaluation-fixture.schema.json",
  "title": "EvaluationFixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "description", "role", "task_types", "candidate", "expected"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "role": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "task_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox", "result", "allowed_commands", "requested_actions", "human_approvals", "policy_decisions"],
      "properties": {
        "sandbox": { "type": "string", "enum": ["read-only", "workspace-write"] },
        "result": { "$ref": "https://surtec.dev/schemas/agent-result.schema.json" },
        "allowed_commands": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "requested_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "human_approvals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "policy_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["boundary", "allowed"],
            "properties": {
              "boundary": { "type": "string", "minLength": 1 },
              "allowed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "hard_failure_codes"],
      "properties": {
        "verdict": { "type": "string", "enum": ["pass", "fail", "hard-fail"] },
        "hard_failure_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
