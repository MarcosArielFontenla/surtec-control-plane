{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/signal-human-state.schema.json",
  "title": "SignalHumanStateDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "records": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": { "pattern": "^sig_[a-f0-9]{24}$" },
      "additionalProperties": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "snoozed_until", "pinned_for", "dismissed", "updated_at"],
      "properties": {
        "state": { "type": "string", "enum": ["open", "acknowledged", "snoozed", "resolved"] },
        "snoozed_until": { "type": ["string", "null"], "maxLength": 100 },
        "pinned_for": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dismissed": { "type": "boolean" },
        "updated_at": { "type": "string", "minLength": 1, "maxLength": 100 },
        "first_action": { "type": "string", "enum": ["acknowledge", "snooze", "pin-for-today", "dismiss", "resolve"] },
        "first_action_at": { "type": "string", "minLength": 1, "maxLength": 100 },
        "signal_evidence_at": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}
