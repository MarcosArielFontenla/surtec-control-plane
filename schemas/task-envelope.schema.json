{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/task-envelope.schema.json",
  "title": "TaskEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "project",
    "task_type",
    "agent",
    "title",
    "instructions",
    "repo_path",
    "branch",
    "sandbox",
    "expected_outputs",
    "requires_human_approval",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "System that produced the task, such as paperclip, github, linear, jira, cli, or dashboard."
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "repo_path": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "sandbox": {
      "type": "string",
      "enum": ["read-only", "workspace-write"]
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_human_approval": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "self_verify": {
      "type": "boolean"
    }
  }
}

