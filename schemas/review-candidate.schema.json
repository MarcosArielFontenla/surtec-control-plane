{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/review-candidate.schema.json",
  "title": "ReviewCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "issue_id", "task_id", "execution_id", "repository_id", "base_revision", "candidate_revision", "diff_fingerprint", "changed_paths", "scope_revision", "created_at", "invalidated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^C-[A-Fa-f0-9-]{36}$" },
    "issue_id": { "type": "string", "pattern": "^I-[A-Fa-f0-9-]{36}$" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "execution_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "repository_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "base_revision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "candidate_revision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "diff_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "changed_paths": { "type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "scope_revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "invalidated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
