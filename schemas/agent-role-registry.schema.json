{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/agent-role-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "id",
          "display_name",
          "responsibility",
          "agent_ids",
          "allowed_task_kinds",
          "sandbox_ceiling",
          "required_skill_ids",
          "required_evaluation_ids",
          "allowed_tool_capabilities",
          "approval_rules",
          "default_budget_policy_id",
          "handoff_contract_ids",
          "minimum_review_depth"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "responsibility": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "agent_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
            }
          },
          "allowed_task_kinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
            }
          },
          "sandbox_ceiling": {
            "enum": [
              "read-only",
              "workspace-write"
            ]
          },
          "required_skill_ids": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
            }
          },
          "required_evaluation_ids": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "allowed_tool_capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspect",
                "edit-authorized-scope",
                "verify-configured"
              ]
            }
          },
          "approval_rules": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
            }
          },
          "default_budget_policy_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          },
          "handoff_contract_ids": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
            }
          },
          "minimum_review_depth": {
            "enum": [
              "focused",
              "full"
            ]
          }
        }
      }
    }
  }
}
