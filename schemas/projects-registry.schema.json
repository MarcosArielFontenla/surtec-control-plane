{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/projects-registry.schema.json",
  "title": "ProjectsRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects"],
  "properties": {
    "projects": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "local_path": { "type": "string", "minLength": 1 },
          "default_branch": { "type": "string", "minLength": 1, "maxLength": 200 },
          "status": { "type": "string", "minLength": 1, "maxLength": 60 },
          "allowed_agents": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" }
          },
          "sandbox": {
            "type": "object",
            "additionalProperties": false,
            "required": ["default"],
            "properties": { "default": { "type": "string", "enum": ["read-only", "workspace-write"] } }
          },
          "commands": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dev": { "type": "string", "minLength": 1 },
              "build": { "type": "string", "minLength": 1 },
              "test": { "type": "string", "minLength": 1 },
              "lint": { "type": "string", "minLength": 1 },
              "install": { "type": "string", "minLength": 1 }
            }
          },
          "verify": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "before_merge": { "type": "boolean" },
              "before_deploy": { "type": "boolean" }
            }
          },
          "deploy_url": { "type": "string", "minLength": 1 },
          "railway": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project_id", "service_id", "environment_id"],
            "properties": {
              "project_id": { "type": "string", "minLength": 1 },
              "service_id": { "type": "string", "minLength": 1 },
              "environment_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}

