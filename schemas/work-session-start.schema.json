{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.local/schemas/work-session-start.schema.json",
  "title": "Start Work Session Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "objective"],
  "properties": {
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "related_task_ids": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" } },
    "related_run_ids": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" } }
  }
}
