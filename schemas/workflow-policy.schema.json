{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/workflow-policy.schema.json",
  "title": "WorkflowPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_budget",
    "correction_budget",
    "automated_correction_default",
    "minimum_review_depth",
    "qa_on_full",
    "protected_path_patterns"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_budget": {
      "$ref": "https://surtec.dev/schemas/workflow-record.schema.json#/$defs/budget"
    },
    "correction_budget": {
      "$ref": "https://surtec.dev/schemas/workflow-record.schema.json#/$defs/correctionBudget"
    },
    "automated_correction_default": {
      "const": false
    },
    "minimum_review_depth": {
      "enum": [
        "focused",
        "full"
      ]
    },
    "qa_on_full": {
      "const": true
    },
    "protected_path_patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "\\S"
      }
    }
  }
}
