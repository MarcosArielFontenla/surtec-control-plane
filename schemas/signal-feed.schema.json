{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/signal-feed.schema.json",
  "title": "SignalFeed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "signals", "pinned_signal_ids", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "observed_at": { "type": "string", "minLength": 1, "maxLength": 100 },
    "signals": { "type": "array", "maxItems": 5000, "items": { "$ref": "signal.schema.json" } },
    "pinned_signal_ids": { "type": "array", "maxItems": 5000, "uniqueItems": true, "items": { "type": "string", "pattern": "^sig_[a-f0-9]{24}$" } },
    "warnings": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 240 } }
  }
}
