{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/signal.schema.json",
  "title": "Signal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "source", "type", "severity", "title", "reason", "evidence_at", "observed_at", "suggested_action", "action_kind", "ranking", "state", "snoozed_until", "evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^sig_[a-f0-9]{24}$" },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "source": { "type": "string", "enum": ["git", "github", "ci", "deployment", "issue", "task", "profile", "note", "session"] },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" },
    "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
    "evidence_at": { "type": "string", "minLength": 1, "maxLength": 100 },
    "observed_at": { "type": "string", "minLength": 1, "maxLength": 100 },
    "suggested_action": { "type": "string", "minLength": 1, "maxLength": 240 },
    "action_kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "order"],
      "properties": {
        "tier": { "type": "string", "enum": ["production-failure", "client-commitment", "blocked-work", "imminent-deadline", "unfinished-work", "maintenance", "hygiene"] },
        "order": { "type": "integer", "minimum": 1, "maximum": 7 }
      }
    },
    "state": { "type": "string", "enum": ["open", "acknowledged", "snoozed", "resolved"] },
    "snoozed_until": { "type": ["string", "null"], "maxLength": 100 },
    "evidence": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["http-health", "railway"] },
        "health": { "type": "string", "enum": ["ok", "degraded", "down", "unknown", "unconfigured"] },
        "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "status": { "type": ["string", "null"], "maxLength": 100 },
        "deployed_at": { "type": ["string", "null"], "maxLength": 100 },
        "branch": { "type": ["string", "null"], "maxLength": 500 },
        "run_started_at": { "type": "string", "maxLength": 100 },
        "run_id": { "type": "string", "maxLength": 100 },
        "run_updated_at": { "type": "string", "maxLength": 100 },
        "duration_minutes": { "type": "integer", "minimum": 0 },
        "dirty": { "type": "boolean" },
        "uncommitted": { "type": "integer", "minimum": 0 },
        "ahead": { "type": "integer", "minimum": 0 },
        "behind": { "type": "integer", "minimum": 0 },
        "pull_request_number": { "type": "integer", "minimum": 1 },
        "review_decision": { "type": "string", "enum": ["CHANGES_REQUESTED", "REVIEW_REQUIRED"] },
        "updated_at": { "type": "string", "maxLength": 100 },
        "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "days_remaining": { "type": "integer" },
        "kind": { "type": "string", "enum": ["client", "personal"] },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "last_activity_at": { "type": ["string", "null"], "maxLength": 100 },
        "inactive_days": { "type": ["integer", "null"], "minimum": 0 },
        "field": { "type": "string", "enum": ["current_goal", "next_action"] },
        "profile_exists": { "type": "boolean" },
        "last_reviewed_at": { "type": ["string", "null"], "maxLength": 100 },
        "days_since_review": { "type": ["integer", "null"], "minimum": 0 },
        "note_id": { "type": "string", "maxLength": 100 },
        "created_at": { "type": "string", "maxLength": 100 },
        "age_days": { "type": "integer", "minimum": 0 },
        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
        "attempts": { "type": "integer", "minimum": 0 },
        "outcome": { "type": ["string", "null"], "enum": ["completed", "partial", "blocked", "failed", "needs-review", "cancelled", null] },
        "lifecycle": { "type": "string", "enum": ["queued", "running", "finished"] },
        "requires_human_approval": { "type": "boolean" },
        "issue_number": { "type": "integer", "minimum": 1 },
        "priority_label": { "type": "string", "maxLength": 100 },
        "session_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" }
      }
    }
  }
}
