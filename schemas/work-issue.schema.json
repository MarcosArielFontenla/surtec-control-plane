{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/work-issue.schema.json",
  "title": "WorkIssue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "objective_id", "parent_issue_id", "title", "expected_outcome", "acceptance_criteria", "status", "work_scale", "classification_inputs", "classification_rationale", "plan", "authorized_scope", "scope_revision", "scope_changed_at", "scope_change_approval_id", "scope_change_proposal", "priority", "criticality", "blocked_by_issue_ids", "assigned_role_id", "related_commitment_ids", "external_references", "next_action", "task_ids", "evidence_ids", "candidate_ids", "created_at", "updated_at", "revision"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^I-[A-Fa-f0-9-]{36}$" },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "objective_id": { "type": ["string", "null"], "maxLength": 100 },
    "parent_issue_id": { "type": ["string", "null"], "pattern": "^I-[A-Fa-f0-9-]{36}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "expected_outcome": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "acceptance_criteria": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "status": { "enum": ["proposed", "authorized", "working", "checking", "needs-decision", "ready-for-review", "done", "blocked", "cancelled"] },
    "work_scale": { "enum": ["trivial", "bounded", "substantial"] },
    "classification_inputs": { "type": "object", "additionalProperties": false, "required": ["affected_domains", "requires_migration", "security_impact"], "properties": { "affected_domains": { "$ref": "#/$defs/labels" }, "requires_migration": { "type": "boolean" }, "security_impact": { "type": "boolean" } } },
    "classification_rationale": { "$ref": "#/$defs/labels" },
    "plan": { "$ref": "#/$defs/labels" },
    "authorized_scope": { "$ref": "#/$defs/scope" },
    "scope_revision": { "type": "integer", "minimum": 1 },
    "scope_changed_at": { "type": ["string", "null"], "format": "date-time" },
    "scope_change_approval_id": { "type": ["string", "null"], "maxLength": 100 },
    "scope_change_proposal": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["id", "discovered_paths", "proposed_scope", "discovered_at", "evidence_task_id"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 100 }, "discovered_paths": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }, "proposed_scope": { "$ref": "#/$defs/scope" }, "discovered_at": { "type": "string", "format": "date-time" }, "evidence_task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" } } }] },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "criticality": { "enum": ["low", "medium", "high"] },
    "blocked_by_issue_ids": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^I-[A-Fa-f0-9-]{36}$" } },
    "assigned_role_id": { "type": ["string", "null"], "maxLength": 100 },
    "related_commitment_ids": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "maxLength": 100 } },
    "external_references": { "type": "array", "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["provider", "url", "reference"], "properties": { "provider": { "type": "string", "minLength": 1, "maxLength": 50 }, "url": { "type": "string", "pattern": "^https?://", "maxLength": 2000 }, "reference": { "type": "string", "minLength": 1, "maxLength": 200 } } } },
    "next_action": { "type": ["string", "null"], "maxLength": 1000 },
    "task_ids": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" } },
    "evidence_ids": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "type": "string", "pattern": "^E-[A-Fa-f0-9-]{36}$" } },
    "candidate_ids": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^C-[A-Fa-f0-9-]{36}$" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "labels": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["expected_outcome", "acceptance_criteria", "allowed_path_patterns", "excluded_path_patterns", "allowed_change_categories", "explicit_exclusions"], "properties": { "expected_outcome": { "type": "string", "minLength": 1, "maxLength": 4000 }, "acceptance_criteria": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }, "allowed_path_patterns": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }, "excluded_path_patterns": { "$ref": "#/$defs/labels" }, "allowed_change_categories": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }, "explicit_exclusions": { "$ref": "#/$defs/labels" } } }
  }
}
