{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.local/schemas/project-profile.schema.json",
  "title": "Local project operating profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "kind",
    "lifecycle",
    "priority",
    "criticality",
    "current_goal",
    "next_action",
    "deadline",
    "client_id",
    "last_reviewed_at",
    "tags"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "kind": { "enum": ["personal", "client"] },
    "lifecycle": { "enum": ["idea", "discovery", "active", "maintenance", "paused", "archived"] },
    "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
    "criticality": { "enum": ["low", "medium", "high"] },
    "current_goal": { "type": ["string", "null"], "minLength": 1, "maxLength": 500, "pattern": "\\S" },
    "next_action": { "type": ["string", "null"], "minLength": 1, "maxLength": 300, "pattern": "\\S" },
    "deadline": { "type": ["string", "null"], "format": "date" },
    "client_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "last_reviewed_at": { "type": ["string", "null"], "format": "date" },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "personal" } }, "required": ["kind"] },
      "then": { "properties": { "client_id": { "const": null } } }
    }
  ]
}
