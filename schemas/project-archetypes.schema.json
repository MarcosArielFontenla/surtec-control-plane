{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:surtec:project-archetypes:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "archetypes"],
  "properties": {
    "schema_version": { "const": 1 },
    "archetypes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personal@1"],
      "properties": {
        "personal@1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verification", "templates", "execution_authority"],
          "properties": {
            "verification": {
              "type": "object",
              "additionalProperties": false,
              "required": ["frontend", "backend"],
              "properties": {
                "frontend": { "const": ["test", "build"] },
                "backend": { "const": ["test", "build"] }
              }
            },
            "templates": {
              "const": [".agents/templates/entity.spec.yaml", ".agents/templates/feature.tasks.md"]
            },
            "execution_authority": { "const": "none" }
          }
        }
      }
    }
  }
}
