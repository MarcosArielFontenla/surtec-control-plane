{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surtec.dev/schemas/agent-result.schema.json",
  "title": "AgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent",
    "status",
    "summary",
    "files_changed",
    "commands_run",
    "tests_run",
    "risks",
    "blockers",
    "next_steps",
    "artifacts",
    "logs_path"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "agent": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "blocked", "failed", "needs-review"]
    },
    "summary": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logs_path": {
      "type": "string"
    },
    "verification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "skipped"]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "ok", "output_tail"],
            "properties": {
              "command": { "type": "string" },
              "ok": { "type": "boolean" },
              "output_tail": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
