{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:surtec:harness-profiles:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
      },
      "additionalProperties": {
        "$ref": "urn:surtec:project-harness-profile:v1"
      }
    }
  }
}
