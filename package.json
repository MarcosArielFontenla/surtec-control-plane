{
  "name": "surtec-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio control plane: one dashboard to see the live status of and orchestrate bespoke git projects, with Claude-powered agent task dispatch.",
  "type": "module",
  "scripts": {
    "state": "tsx cli/surtec-state.ts",
    "dev:api": "tsx dashboard/src/server/serve.ts",
    "dev:ui": "vite",
    "dev": "concurrently -n api,ui -c blue,green \"pnpm dev:api\" \"pnpm dev:ui\"",
    "build": "vite build",
    "start": "tsx dashboard/src/server/serve.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.154",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
